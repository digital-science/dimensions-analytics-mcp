{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.dimensions/analytics-mcp",
  "title": "Dimensions Analytics",
  "description": "Search and analyze Dimensions research data: publications, grants, researchers, patents, trials",
  "repository": {
    "url": "https://github.com/digital-science/dimensions-analytics-mcp",
    "source": "github",
    "subfolder": "apps/mcp"
  },
  "websiteUrl": "https://github.com/digital-science/dimensions-analytics-mcp#readme",
  "version": "1.4.7",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@digital-science-dsl/dimensions-analytics-mcp",
      "version": "1.4.7",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DIMENSIONS_API_KEY",
          "description": "Dimensions API key (same key as the Dimensions DSL API)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "DIMENSIONS_BASE_URL",
          "description": "Dimensions API base URL. Required for custom instances, e.g. https://your-instance.dimensions.ai",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.dimensions.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Dimensions API key as a Bearer token (same key as the Dimensions DSL API). Standard instance (app.dimensions.ai) only.",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Dimensions API key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tags": [
        "research",
        "publications",
        "grants",
        "patents",
        "clinical-trials",
        "bibliometrics",
        "analytics"
      ]
    }
  }
}
